{
  "name": "iterminal",
  "version": "0.0.0",
  "private": true,
  "description": "A shared persistent terminal runtime where humans and agents act as equal participants.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @iterminal/console build",
    "build:console": "pnpm --filter @iterminal/console build",
    "cli": "tsx apps/cli/src/main.ts",
    "console": "tsx apps/console/src/main.ts",
    "daemon": "tsx apps/runtime-daemon/src/main.ts",
    "execution-worker": "tsx apps/execution-worker/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "mcp": "tsx apps/mcp/src/main.ts",
    "outbox-relay": "tsx apps/outbox-relay/src/main.ts",
    "router": "tsx apps/runtime-router/src/main.ts",
    "spike:shell": "tsx spikes/shell-integration/src/cli.ts",
    "test": "vitest run",
    "test:m1": "vitest run packages/application/src/runtime-service.test.ts",
    "test:m2": "vitest run packages/persistence-postgres/src/postgres-runtime-repository.test.ts",
    "test:m3": "vitest run packages/persistence-postgres/src/postgres-observation-repository.test.ts",
    "test:m4": "vitest run apps/mcp/src/mcp-stdio.test.ts",
    "test:m4:durable": "vitest run apps/runtime-daemon/src/durable-runtime.test.ts",
    "test:m5": "vitest run apps/console/src/server.test.ts",
    "test:m5:browser": "pnpm build:console && vitest run apps/console/src/browser-shared-path.test.ts",
    "test:m6:interaction": "vitest run packages/application/src/interaction-policy.test.ts packages/persistence-postgres/src/postgres-interaction-guard.test.ts apps/runtime-daemon/src/interaction-policy.test.ts",
    "test:m6:resize": "vitest run packages/terminal-screen/src/index.test.ts packages/persistence-postgres/src/postgres-terminal-geometry.test.ts apps/runtime-daemon/src/resize.test.ts",
    "test:m6:resize:browser": "pnpm build:console && vitest run apps/console/src/browser-shared-path.test.ts",
    "test:m6:state": "vitest run packages/application/src/terminal-state.test.ts apps/mcp/src/terminal-state.test.ts",
    "test:m7:fork": "vitest run --maxWorkers=1 packages/executor-pty/src/control-protocol.test.ts packages/application/src/session-fork.test.ts apps/mcp/src/session-fork.test.ts apps/runtime-daemon/src/session-fork-durable.test.ts apps/runtime-daemon/src/session-rebuild-durable.test.ts apps/console/src/server.test.ts",
    "test:m7:rebuild:browser": "pnpm build:console && vitest run apps/console/src/browser-shared-path.test.ts -t 'historical checkpoint'",
    "test:m8:messaging": "vitest run packages/queue-rabbitmq/src/rabbitmq-messaging.test.ts",
    "test:m8:dispatch": "vitest run apps/execution-worker/src/execution-worker.test.ts",
    "test:m8:interactions": "vitest run apps/runtime-daemon/src/interaction-crash.test.ts",
    "test:m8:admission": "vitest run apps/runtime-daemon/src/admission-backpressure.test.ts",
    "test:m8:reconnect": "vitest run apps/execution-worker/src/broker-reconnect.test.ts",
    "test:m8:postgres-outage": "vitest run apps/runtime-daemon/src/postgres-outage.test.ts",
    "test:m8:postgres-loops": "vitest run apps/execution-worker/src/postgres-recovery.test.ts",
    "test:m8:network": "vitest run apps/execution-worker/src/network-partition.test.ts",
    "test:m8:quorum": "vitest run apps/execution-worker/src/quorum-failover.test.ts",
    "test:m9:registry": "vitest run --maxWorkers=1 packages/persistence-postgres/src/postgres-runtime-owner-registry.test.ts apps/runtime-daemon/src/owner-registry.test.ts",
    "test:m9:router": "vitest run --maxWorkers=1 apps/runtime-router/src/server.test.ts apps/runtime-router/src/runtime-router.test.ts apps/mcp/src/router-routing.test.ts apps/execution-worker/src/execution-worker.test.ts",
    "test:m9:fencing": "vitest run --maxWorkers=1 packages/persistence-postgres/src/postgres-session-fencing.test.ts apps/runtime-daemon/src/owner-registry.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:docs && pnpm build",
    "verify:docs": "node scripts/check-verification.mjs"
  },
  "devDependencies": {
    "@iterminal/application": "workspace:*",
    "@iterminal/domain": "workspace:*",
    "@iterminal/executor-pty": "workspace:*",
    "@iterminal/persistence-postgres": "workspace:*",
    "@iterminal/protocol": "workspace:*",
    "@iterminal/runtime-memory": "workspace:*",
    "@iterminal/testkit": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "pg": "^8.16.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
